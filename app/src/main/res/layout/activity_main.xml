<?xml version="1.0" encoding="utf-8"?>
<!--suppress ALL -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="0dp"
    android:layout_marginBottom="0dp"
    android:clipToPadding="false"
    android:background="#2F5D8A"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="7dp"
        android:orientation="vertical">

        <!-- Title Bar: SAFETY BOARD -->
        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:padding="12dp"
            android:text="SAFETY BOARD"
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <!-- Find Wifi / Settings row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:orientation="horizontal"
            android:padding="0dp">

            <Button
                android:id="@+id/buttonWifi"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:text="Find Wifi"
                android:textSize="10sp"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/buttonSettings"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="175dp"
                android:gravity="center"
                android:text="Settings"
                android:textSize="10sp"
                tools:ignore="TouchTargetSizeCheck" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:orientation="horizontal"
            android:padding="0dp">

            <Button
                android:id="@+id/buttonDateTimeOptions"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="Date/Time"
                android:textSize="10sp"
                tools:ignore="TouchTargetSizeCheck,TextContrastCheck,TextSizeCheck" />

        </LinearLayout>

        <!-- Status row -->
        <TextView
            android:id="@+id/textViewStatus"
            android:layout_width="201dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:text="Status: "
            android:textColor="#BDBDBD"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Date / Time row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                tools:ignore="TextSizeCheck">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="8dp"
                    android:text="DATE:"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText,TextContrastCheck" />

                <EditText
                    android:id="@+id/editText1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:background="#FFFFFF"
                    android:cursorVisible="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:hint="DD.MM.YY"
                    android:inputType="date"
                    android:minHeight="40dp"
                    android:textColor="#000000"
                    tools:ignore="Autofill,HardcodedText,VisualLintTextFieldSize,TouchTargetSizeCheck,TextContrastCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="8dp"
                    android:text="TIME:"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText,TextContrastCheck" />

                <EditText
                    android:id="@+id/editText2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#FFFFFF"
                    android:cursorVisible="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:hint="HH:MM:SS"
                    android:inputType="time"
                    android:minHeight="40dp"
                    android:textColor="#000000"
                    tools:ignore="Autofill,HardcodedText,VisualLintTextFieldSize,TouchTargetSizeCheck,TextContrastCheck" />
            </LinearLayout>

            <!-- Date of last accident row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                tools:ignore="TextSizeCheck">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="DATE OF LAST ACCIDENT"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText,TextContrastCheck" />

                <EditText
                    android:id="@+id/editText3"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:cursorVisible="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:hint="0000"
                    android:inputType="number"
                    android:minHeight="40dp"
                    android:textColor="#000000"
                    tools:ignore="Autofill,HardcodedText,VisualLintTextFieldSize,TouchTargetSizeCheck,TextContrastCheck" />
            </LinearLayout>

            <!-- No. of Accident Free days row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                tools:ignore="TextSizeCheck">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="NO.Of ACCIDENT FREE DAYS"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText,TextContrastCheck" />

                <EditText
                    android:id="@+id/editText4"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="10dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:hint="0000"
                    android:maxLength="4"
                    android:inputType="number"
                    android:textColor="#000000"
                    tools:ignore="Autofill,HardcodedText,TouchTargetSizeCheck,TextContrastCheck" />

                <Button
                    android:id="@+id/buttonReset"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/rounded_green"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Reset"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText,ButtonStyle,TextContrastCheck,TouchTargetSizeCheck" />

            </LinearLayout>
            <!-- Previous Best row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                tools:ignore="TextSizeCheck">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="PREVIOUS BEST"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText,TextContrastCheck" />

                <EditText
                    android:id="@+id/editText5"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:cursorVisible="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:hint="0000"
                    android:maxLength="4"
                    android:inputType="number"
                    android:minHeight="40dp"
                    android:textColor="#000000"
                    tools:ignore="Autofill,HardcodedText,VisualLintTextFieldSize,TouchTargetSizeCheck,TextContrastCheck" />
            </LinearLayout>

        </LinearLayout>

        <!-- Clear / Send row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:padding="0dp">

            <Button
                android:id="@+id/buttonClear"
                android:layout_width="20dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginStart="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_red"
                android:gravity="center"
                android:padding="10dp"
                android:text="Clear"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="ButtonStyle,HardcodedText,VisualLintButtonSize,TextContrastCheck,TextSizeCheck,TouchTargetSizeCheck" />

            <Button
                android:id="@+id/buttonSend"
                android:layout_width="20dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginStart="5dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_blue"
                android:gravity="center"
                android:padding="10dp"
                android:text="Send"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:ignore="ButtonStyle,HardcodedText,VisualLintButtonSize,TextContrastCheck,TouchTargetSizeCheck" />

        </LinearLayout>

        <!-- Footer: Skylark gif + heading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="0dp"
            android:orientation="horizontal"
            android:padding="0dp">

            <pl.droidsonroids.gif.GifImageView
                android:id="@+id/gifImageView"
                android:layout_width="66dp"
                android:layout_height="53dp"
                android:src="@drawable/skylarkgifi"
                tools:ignore="ImageContrastCheck" />

            <ImageView
                android:id="@+id/logoImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="0dp"
                android:layout_marginBottom="0dp"
                android:contentDescription="App Logo"
                android:src="@drawable/skylarkheading"
                tools:ignore="HardcodedText,ImageContrastCheck" />

        </LinearLayout>

        <!-- Footer: Skylark Address -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:padding="0dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/logoImageViewAddress"
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:contentDescription="App Logo"
                android:src="@drawable/skylarkaddress"
                tools:ignore="HardcodedText,ImageContrastCheck" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>